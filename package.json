{
  "name": "keynote",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,app \"npm:dev:api\" \"npm:dev:app\"",
    "dev:api": "PORT=3001 node server.mjs",
    "dev:app": "ng serve --host 0.0.0.0 --port 3000 --proxy-config proxy.conf.json",
    "build": "ng build",
    "start": "NODE_ENV=production node server.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.6",
    "@fontsource-variable/manrope": "^5.2.8",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "express": "^5.1.0",
    "lucide": "^0.468.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "concurrently": "^9.2.1",
    "typescript": "~6.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
